# Supabase/Postgres. Use the database connection string, not the PostgREST URL.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=roadsift
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=300

# Kaggle. Prefer KAGGLE_API_TOKEN or ~/.kaggle credentials.
KAGGLE_KERNEL_SLUG=owner/roadsift-mining
KAGGLE_ACCELERATOR=
